KITSU_HOST=https://iim-digital-school.cg-wire.com/api
KITSU_USER=you@example.com
KITSU_PASSWORD=

# Optional
# KITSU_ALLOW_WRITE=false   # expose tools that modify Kitsu (comments, status, assignment, schedule, time)
# KITSU_CACHE_TTL=300       # seconds to cache projects, task types, statuses and people
# KITSU_TIMEOUT=30          # per-request timeout in seconds
# KITSU_MAX_RETRIES=3       # attempts for reads that hit a server or network error
