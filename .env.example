KITSU_HOST=https://your-studio.cg-wire.com/api
KITSU_USER=you@example.com
KITSU_PASSWORD=

# Optional (defaults shown; see the README's Configuration section)
# KITSU_ALLOW_WRITE=false     # expose tools that modify Kitsu (comments, status, assignment, schedule, time, playlists)
# KITSU_TOOL_GROUPS=write     # groups listed from the start besides core (browse, activity, planning, review, write, all)
# KITSU_CACHE_TTL=300         # seconds to cache projects, task types, statuses, people, departments, custom fields
# KITSU_TIMEOUT=30            # per-request timeout in seconds
# KITSU_MAX_RETRIES=3         # attempts for reads that hit a server or network error
# KITSU_DRY_RUN_LOG=          # JSONL file each write-tool dry run is appended to

# Status roles: comma-separated status names or short names (case-insensitive) that take a role whatever
# Kitsu flags. Any other status gets its role from Kitsu's flags.
# KITSU_OMITTED_STATUSES=omit,na,n/a,omitted,cancelled,canceled
# KITSU_DONE_STATUSES=        # e.g. cbb, for a "could be better" status meaning done
# KITSU_ON_HOLD_STATUSES=stand by,standby,pause,paused,blocked,on hold
# KITSU_REVIEW_STATUSES=
# KITSU_RETAKE_STATUSES=

# Video tools (the [video] extra)
# KITSU_VIDEO_CACHE_DIR=      # default: kitsu-mcp-videos in the system temp dir
# KITSU_VIDEO_CACHE_MB=1024   # movie cache size; least recently used movies are deleted past it
# KITSU_VIDEO_MAX_MB=500      # largest movie the video tools download

# HTTP mode (kitsu-mcp --http): callers send their own Kitsu login, KITSU_USER / KITSU_PASSWORD are unused
# KITSU_HTTP_HOST=127.0.0.1
# PORT=8000
# KITSU_BEHIND_TLS=false      # required to listen on a public address; set only behind an HTTPS proxy
